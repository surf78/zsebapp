@page "/szamlak"
@inherits DataPage

<PageTitle>Számlák – ZsebApp</PageTitle>

<header class="topbar">
    <h1>Számlák</h1>
    <button class="icon-btn primary" @onclick="ToggleNew" aria-label="Új számla" aria-expanded="@(editorOpen ? "true" : "false")">
        <Icon Name="plus" Class="@(editorOpen ? "rotate-45" : null)" />
    </button>
</header>

<div class="page">
    <BillsSubNav />

    @if (!loaded)
    {
    }
    else
    {
        @if (editorOpen)
        {
            <form class="card form" @onsubmit="Save">
                <p class="form-title">@EditorTitle</p>

                <div class="field">
                    <span>Csoport</span>
                    <div class="chips">
                        @foreach (var g in AllGroups)
                        {
                            <button type="button" class="chip neutral @(!fNewGroupMode && Same(g, fGroup) ? "selected" : null)"
                                    @onclick="() => { fGroup = g; fNewGroupMode = false; }">
                                @g
                            </button>
                        }
                        <button type="button" class="chip neutral @(fNewGroupMode ? "selected" : null)" @onclick="() => fNewGroupMode = true">
                            + Új csoport
                        </button>
                    </div>
                    @if (fNewGroupMode)
                    {
                        <input class="input" placeholder="Új csoport neve, pl. Nyaraló" maxlength="40" @bind="fNewGroup" @bind:event="oninput" />
                    }
                </div>

                <label class="field">
                    <span>Megnevezés</span>
                    <input class="input" placeholder="pl. Gázszámla" maxlength="80" @bind="fName" @bind:event="oninput" />
                </label>

                <label class="field">
                    <span>Összeg (Ft)</span>
                    <input class="input amount-input" type="text" inputmode="numeric" pattern="[0-9 ]*"
                           placeholder="0" maxlength="12" @bind="fAmount" @bind:event="oninput" />
                </label>

                <div class="field-row">
                    <label class="field grow">
                        <span>Fizetési határidő</span>
                        <input class="input date-input" type="date" @bind="fDue" @bind:format="yyyy-MM-dd" />
                    </label>
                    <label class="field">
                        <span>Hónap</span>
                        <input class="input date-input" type="month" value="@fMonth" @onchange="e => fMonth = e.Value?.ToString() ?? fMonth" />
                    </label>
                </div>

                <div class="field">
                    <span>Állapot</span>
                    <div class="segmented" role="radiogroup" aria-label="Állapot">
                        <button type="button" role="radio" aria-checked="@(!fPaid ? "true" : "false")"
                                class="seg unpaid @(!fPaid ? "selected" : null)" @onclick="() => fPaid = false">
                            Rendezetlen
                        </button>
                        <button type="button" role="radio" aria-checked="@(fPaid ? "true" : "false")"
                                class="seg paid @(fPaid ? "selected" : null)" @onclick="() => fPaid = true">
                            Fizetve
                        </button>
                    </div>
                </div>

                @if (editing is null && fromTemplate is null)
                {
                    <label class="check-row">
                        <input type="checkbox" @bind="fRecurring" />
                        <span>Fix tétel – minden hónapban jelenjen meg</span>
                    </label>
                }

                @if (fError is not null)
                {
                    <p class="error">@fError</p>
                }

                <button type="submit" class="btn primary block">Mentés</button>
                <div class="btn-row">
                    @if (editing is not null)
                    {
                        <button type="button" class="btn danger" @onclick="DeleteEditing">Törlés</button>
                    }
                    <button type="button" class="btn" @onclick="CloseEditor">Mégse</button>
                </div>
            </form>
        }

        <section class="card filter-body report-period">
            <PeriodPicker Value="period" ValueChanged="SetPeriod" />
            <div class="chips chips-scroll">
                <button type="button" class="chip neutral @(group is null ? "selected" : null)" @onclick="() => group = null">Mind</button>
                @foreach (var g in AllGroups)
                {
                    <button type="button" class="chip neutral @(Same(g, group) ? "selected" : null)" @onclick="() => group = g">@g</button>
                }
            </div>
        </section>

        var months = Views;
        var allRows = months.SelectMany(m => m.Rows).ToList();
        var unpaidRows = allRows.Where(r => !r.Paid).ToList();
        var paidRows = allRows.Where(r => r.Paid).ToList();

        <section class="bill-summary">
            <div class="card bill-total unpaid">
                <span class="bill-total-label">Rendezetlen</span>
                <span class="bill-total-value">@Fmt.Ft(unpaidRows.Sum(r => (long)r.Amount))</span>
                <span class="bill-total-sub">@unpaidRows.Count db@(unpaidRows.Any(r => r.IsOverdue) ? $" · {unpaidRows.Count(r => r.IsOverdue)} lejárt" : "")</span>
            </div>
            <div class="card bill-total paid">
                <span class="bill-total-label">Fizetve</span>
                <span class="bill-total-value">@Fmt.Ft(paidRows.Sum(r => (long)r.Amount))</span>
                <span class="bill-total-sub">@paidRows.Count db</span>
            </div>
        </section>

        @if (allRows.Count == 0)
        {
            <EmptyState IconName="receipt" Title="Nincs számla" Text="Ebben az időszakban / csoportban nincs számla. A + gombbal vehetsz fel újat." />
        }

        @foreach (var m in months)
        {
            <h2 class="month-header">@m.Title</h2>
            @foreach (var g in m.Groups)
            {
                @if (PropertyKind(g.Name) is { } kind)
                {
                    var open = Same(managing, g.Name);
                    @* Ház / Lakás / Rendszeres utalás csoport: kiemelt fejléc; koppintásra a csoport fix tételei szerkeszthetők *@
                    <button type="button" class="group-header @kind @(open ? "open" : null)" @onclick="() => ToggleManage(g.Name)"
                            aria-expanded="@(open ? "true" : "false")" aria-label="@($"{g.Name} – fix tételek szerkesztése")">
                        <span class="group-icon"><Icon Name="@GroupIcon(kind)" Size="20" /></span>
                        <span class="group-title">
                            <strong>@g.Name</strong>
                            <small>@g.PaidCount/@g.Rows.Count fizetve@(g.Unpaid > 0 ? $" · rendezetlen: {Fmt.Ft(g.Unpaid)}" : "")</small>
                        </span>
                        <span class="group-edit"><Icon Name="@(open ? "chevron-down" : "edit")" Size="18" Class="@(open ? "rotate-180" : null)" /></span>
                    </button>

                    @if (open)
                    {
                        var items = Data.BillTemplates.Where(t => Same(t.Group, g.Name)).ToList();
                        <section class="card form group-manage">
                            <p class="form-title">Fix tételek – @g.Name</p>

                            @if (items.Count == 0)
                            {
                                <p class="form-note">Ebben a csoportban még nincs fix tétel.</p>
                            }
                            else
                            {
                                <ul class="list template-list">
                                    @foreach (var t in items)
                                    {
                                        <li class="row" @key="t.Id">
                                            @if (teId == t.Id)
                                            {
                                                <div class="template-edit">
                                                    <input class="input" placeholder="Megnevezés" maxlength="80" @bind="teName" @bind:event="oninput" aria-label="Megnevezés" />
                                                    <div class="field-row">
                                                        <input class="input" inputmode="numeric" placeholder="Összeg (Ft)" maxlength="12" @bind="teAmount" @bind:event="oninput" aria-label="Összeg" />
                                                        <input class="input small-input" inputmode="numeric" placeholder="Határidő napja" maxlength="2" @bind="teDueDay" @bind:event="oninput" aria-label="Határidő napja" />
                                                    </div>
                                                    @if (teError is not null)
                                                    {
                                                        <p class="error">@teError</p>
                                                    }
                                                    <div class="btn-row">
                                                        <button type="button" class="btn" @onclick="CancelTemplateEdit">Mégse</button>
                                                        <button type="button" class="btn primary" @onclick="() => SaveTemplateEdit(t)">Mentés</button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row-main tappable-area" @onclick="() => StartTemplateEdit(t)">
                                                    <div class="bill-name">@t.Name</div>
                                                    <div class="row-sub">
                                                        <span>@(t.DefaultAmount is { } a ? Fmt.Ft(a) : "változó összeg")</span>
                                                        @if (t.DueDay is { } dd)
                                                        {
                                                            <span>· határidő: minden hó @(dd).</span>
                                                        }
                                                    </div>
                                                </div>
                                                <button type="button" class="icon-btn ghost" @onclick="() => StartTemplateEdit(t)" aria-label="@($"{t.Name} szerkesztése")">
                                                    <Icon Name="edit" Size="20" />
                                                </button>
                                                @if (confirmDeleteId == t.Id)
                                                {
                                                    <button type="button" class="btn danger confirm-delete" @onclick="() => DeleteTemplate(t)">Törlöd?</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="icon-btn ghost danger" @onclick="() => confirmDeleteId = t.Id" aria-label="@($"{t.Name} törlése")">
                                                        <Icon Name="trash" Size="20" />
                                                    </button>
                                                }
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            <span class="filter-label">Új tétel ebbe a csoportba</span>
                            <input class="input" placeholder="Megnevezés, pl. Internet" maxlength="80" @bind="ngName" @bind:event="oninput" aria-label="Új tétel neve" />
                            <div class="field-row">
                                <input class="input" inputmode="numeric" placeholder="Összeg (Ft)" maxlength="12" @bind="ngAmount" @bind:event="oninput" aria-label="Új tétel összege" />
                                <input class="input small-input" inputmode="numeric" placeholder="Határidő napja" maxlength="2" @bind="ngDueDay" @bind:event="oninput" aria-label="Új tétel határidejének napja" />
                            </div>
                            @if (ngError is not null)
                            {
                                <p class="error">@ngError</p>
                            }
                            <button type="button" class="btn primary block" @onclick="() => AddGroupTemplate(g.Name)">Hozzáadás</button>

                            <span class="filter-label">Csoport neve</span>
                            <div class="add-member">
                                <input class="input" maxlength="40" @bind="mgGroupName" @bind:event="oninput" aria-label="Csoport neve" />
                                <button type="button" class="btn" disabled="@(string.IsNullOrWhiteSpace(mgGroupName) || mgGroupName.Trim() == g.Name)"
                                        @onclick="() => RenameGroup(g.Name)">Átnevezés</button>
                            </div>

                            <p class="report-note">A módosítás a még nem rögzített sorokra érvényes; a már rögzített számlák változatlanok maradnak.</p>
                            <button type="button" class="btn block" @onclick="() => managing = null">Kész</button>
                        </section>
                    }
                }
                else
                {
                    <p class="section-label">
                        <span>@g.Name</span>
                        <span>@g.PaidCount/@g.Rows.Count fizetve</span>
                    </p>
                }
                <ul class="card list">
                    @foreach (var r in g.Rows)
                    {
                        <li class="row bill-row @(r.IsVirtual ? "virtual" : null)" @key="r.Key">
                            <div class="row-main tappable-area" @onclick="() => OpenRow(r, m.MonthKey)">
                                <div class="bill-name">@r.Name</div>
                                <div class="row-sub">
                                    @if (r.IsOverdue)
                                    {
                                        <span class="overdue">lejárt: @Fmt.TinyDate(r.DueDate!.Value)</span>
                                    }
                                    else if (r.DueDate is { } due)
                                    {
                                        <span>határidő: @Fmt.TinyDate(due)</span>
                                    }
                                    @if (r.IsVirtual)
                                    {
                                        <span class="muted">@(r.DueDate is null ? "még nincs rögzítve" : "· még nincs rögzítve")</span>
                                    }
                                    else if (r.Paid && r.Bill!.PaidAt is { } paidAt)
                                    {
                                        <span>fizetve: @Fmt.TinyDate(DateOnly.FromDateTime(paidAt))</span>
                                    }
                                </div>
                            </div>
                            <div class="bill-right">
                                <span class="amount">@(r.Amount > 0 ? Fmt.Ft(r.Amount) : "– Ft")</span>
                                <button class="status-pill @(r.Paid ? "paid" : "unpaid")" @onclick="() => TogglePaid(r, m.MonthKey)"
                                        aria-label="@(r.Paid ? "Fizetve – koppints a Rendezetlenre váltáshoz" : "Rendezetlen – koppints a Fizetvére váltáshoz")">
                                    @(r.Paid ? "Fizetve" : "Rendezetlen")
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            }
        }

        @if (allRows.Count > 0)
        {
            <p class="hint">A sorra koppintva szerkesztheted a számlát, az állapotra koppintva Rendezetlen és Fizetve között válthatsz.</p>
        }

        @* ---------- Fix tételek kezelése ---------- *@
        <section class="card templates-card">
            <button type="button" class="filter-toggle" @onclick="() => showTemplates = !showTemplates" aria-expanded="@(showTemplates ? "true" : "false")">
                <Icon Name="list" Size="18" />
                <span class="filter-summary">Fix tételek kezelése (@Data.BillTemplates.Count)</span>
                <Icon Name="chevron-down" Size="18" Class="@(showTemplates ? "rotate-180" : null)" />
            </button>

            @if (showTemplates)
            {
                <div class="filter-body">
                    @foreach (var g in Data.BillTemplates.GroupBy(t => t.Group))
                    {
                        <span class="filter-label">@g.Key</span>
                        <ul class="list template-list">
                            @foreach (var t in g)
                            {
                                <li class="row" @key="t.Id">
                                    <div class="row-main">
                                        <div class="bill-name">@t.Name</div>
                                        <div class="row-sub">
                                            <span>@(t.DefaultAmount is { } a ? Fmt.Ft(a) : "változó összeg")</span>
                                            @if (t.DueDay is { } dd)
                                            {
                                                <span>· határidő: minden hó @(dd).</span>
                                            }
                                        </div>
                                    </div>
                                    <button class="icon-btn ghost" @onclick="() => DeleteTemplate(t)" aria-label="Fix tétel törlése">
                                        <Icon Name="trash" Size="20" />
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                    <span class="filter-label">Új fix tétel</span>
                    <div class="chips">
                        @foreach (var g in AllGroups)
                        {
                            <button type="button" class="chip neutral @(!tNewGroupMode && Same(g, tGroup) ? "selected" : null)"
                                    @onclick="() => { tGroup = g; tNewGroupMode = false; }">
                                @g
                            </button>
                        }
                        <button type="button" class="chip neutral @(tNewGroupMode ? "selected" : null)" @onclick="() => tNewGroupMode = true">+ Új csoport</button>
                    </div>
                    @if (tNewGroupMode)
                    {
                        <input class="input" placeholder="Új csoport neve" maxlength="40" @bind="tNewGroup" @bind:event="oninput" />
                    }
                    <input class="input" placeholder="Megnevezés, pl. Internet" maxlength="80" @bind="tName" @bind:event="oninput" />
                    <div class="field-row">
                        <input class="input" inputmode="numeric" placeholder="Összeg (nem kötelező)" maxlength="12" @bind="tAmount" @bind:event="oninput" />
                        <input class="input small-input" inputmode="numeric" placeholder="Határidő napja" maxlength="2" @bind="tDueDay" @bind:event="oninput" />
                    </div>
                    @if (tError is not null)
                    {
                        <p class="error">@tError</p>
                    }
                    <button type="button" class="btn primary block" @onclick="AddTemplate">Fix tétel hozzáadása</button>
                    <p class="report-note">A törölt fix tétel kitöltendő sorként már nem jelenik meg; a korábban rögzített számlái megmaradnak.</p>
                </div>
            }
        </section>
    }
</div>

@code {
    private bool loaded;
    private bool showTemplates;

    // Szűrés: alapból az aktuális hónap
    private Period period = Period.Containing(PeriodKind.Month, Period.Today);
    private string? group;

    // Szerkesztő
    private bool editorOpen;
    private Bill? editing;
    private BillTemplate? fromTemplate;
    private string fGroup = BillDefaults.OtherGroup;
    private bool fNewGroupMode;
    private string fNewGroup = "";
    private string fName = "";
    private string fAmount = "";
    private DateOnly? fDue;
    private string fMonth = BillMonth.Key(Period.Today);
    private bool fPaid;
    private bool fRecurring;
    private string? fError;

    // Új fix tétel
    private string tGroup = "";
    private bool tNewGroupMode;
    private string tNewGroup = "";
    private string tName = "";
    private string tAmount = "";
    private string tDueDay = "";
    private string? tError;

    // Kiemelt csoport fix tételeinek szerkesztése (a csoport fejlécére koppintva)
    private string? managing;
    private string mgGroupName = "";
    private Guid? teId;
    private string teName = "";
    private string teAmount = "";
    private string teDueDay = "";
    private string? teError;
    private Guid? confirmDeleteId;
    private string ngName = "";
    private string ngAmount = "";
    private string ngDueDay = "";
    private string? ngError;

    /// <summary>
    /// "house" a Ház…, "flat" a Lakás…, "transfer" a Rendszeres utalás csoportra (ezek kiemelt fejlécet kapnak), egyébként null.
    /// </summary>
    private static string? PropertyKind(string group) =>
        group.StartsWith("Ház", StringComparison.OrdinalIgnoreCase) ? "house"
        : group.StartsWith("Lakás", StringComparison.OrdinalIgnoreCase) ? "flat"
        : group.StartsWith("Rendszeres", StringComparison.OrdinalIgnoreCase) ? "transfer"
        : null;

    private static string GroupIcon(string kind) => kind switch
    {
        "house" => "home",
        "flat" => "building",
        _ => "repeat",
    };

    private static bool Same(string? a, string? b) =>
        a is not null && b is not null && string.Equals(a.Trim(), b.Trim(), StringComparison.OrdinalIgnoreCase);

    private List<string> AllGroups => BillViews.Groups(Data.BillTemplates, Data.Bills);

    private string ViewMonthKey => period.Kind == PeriodKind.Month ? BillMonth.Key(period.Start) : BillMonth.Key(Period.Today);

    private List<BillMonthView> Views =>
        period.Kind == PeriodKind.Month
            ? [BillViews.Month(Data.Bills, Data.BillTemplates, ViewMonthKey, group)]
            : BillViews.Range(Data.Bills, Data.BillTemplates, period, group);

    private string EditorTitle =>
        editing is not null ? "Számla szerkesztése"
        : fromTemplate is not null ? $"{fromTemplate.Name} – {BillViews.MonthTitle(fMonth)}"
        : "Új számla";

    protected override async Task OnInitializedAsync()
    {
        await Data.EnsureLoadedAsync();
        tGroup = AllGroups.FirstOrDefault() ?? BillDefaults.OtherGroup;
        loaded = true;
    }

    private void SetPeriod(Period p) => period = p;

    private static int? ParseAmount(string text)
    {
        var digits = new string((text ?? "").Where(char.IsDigit).ToArray());
        return int.TryParse(digits, out var v) ? v : null;
    }

    // ---------- Szerkesztő ----------

    private void ResetEditor()
    {
        editing = null;
        fromTemplate = null;
        fGroup = group ?? BillDefaults.OtherGroup;
        fNewGroupMode = false;
        fNewGroup = "";
        fName = "";
        fAmount = "";
        fDue = null;
        fMonth = ViewMonthKey;
        fPaid = false;
        fRecurring = false;
        fError = null;
    }

    private void ToggleNew()
    {
        if (editorOpen)
        {
            CloseEditor();
            return;
        }
        ResetEditor();
        editorOpen = true;
    }

    private void CloseEditor()
    {
        editorOpen = false;
        ResetEditor();
    }

    private void OpenRow(BillRow r, string monthKey)
    {
        ResetEditor();
        if (r.Bill is { } b)
        {
            editing = b;
            fGroup = BillViews.GroupOf(b);
            fName = b.Name;
            fAmount = b.Amount > 0 ? b.Amount.ToString() : "";
            fDue = b.DueDate;
            fMonth = b.EffectiveMonth;
            fPaid = b.Paid;
        }
        else if (r.Template is { } t)
        {
            fromTemplate = t;
            fGroup = t.Group;
            fName = t.Name;
            fAmount = t.DefaultAmount?.ToString() ?? "";
            fDue = BillViews.TemplateDueDate(t, monthKey);
            fMonth = monthKey;
        }
        editorOpen = true;
    }

    private async Task Save()
    {
        var groupName = (fNewGroupMode ? fNewGroup : fGroup).Trim();
        if (groupName.Length == 0)
        {
            fError = "Add meg a csoport nevét.";
            return;
        }

        var name = fName.Trim();
        if (name.Length == 0)
        {
            fError = "Add meg a számla nevét.";
            return;
        }

        if (ParseAmount(fAmount) is not { } amount || amount <= 0)
        {
            fError = "Adj meg egy 0-nál nagyobb összeget.";
            return;
        }

        if (!BillMonth.TryParse(fMonth ?? "", out _))
            fMonth = fDue is { } d ? BillMonth.Key(d) : ViewMonthKey;

        var bill = editing ?? new Bill { TemplateId = fromTemplate?.Id };
        var wasPaid = bill.Paid;
        bill.Group = groupName == BillDefaults.OtherGroup ? "" : groupName;
        bill.Name = name;
        bill.Amount = amount;
        bill.DueDate = fDue;
        bill.Month = fMonth;
        bill.Paid = fPaid;
        bill.PaidAt = fPaid ? (wasPaid ? bill.PaidAt ?? DateTime.Now : DateTime.Now) : null;

        if (editing is null)
        {
            Data.Bills.Add(bill);
            if (fRecurring && fromTemplate is null)
            {
                var template = new BillTemplate { Group = groupName, Name = name, DefaultAmount = amount, DueDay = fDue?.Day };
                Data.BillTemplates.Add(template);
                bill.TemplateId = template.Id;
                await Data.SaveBillTemplatesAsync();
            }
        }
        await Data.SaveBillsAsync();
        CloseEditor();
    }

    private async Task DeleteEditing()
    {
        if (editing is null) return;
        Data.Bills.Remove(editing);
        await Data.SaveBillsAsync();
        CloseEditor();
    }

    // ---------- Állapot váltása a listában ----------

    private async Task TogglePaid(BillRow r, string monthKey)
    {
        if (r.Bill is { } b)
        {
            b.Paid = !b.Paid;
            b.PaidAt = b.Paid ? DateTime.Now : null;
            await Data.SaveBillsAsync();
            return;
        }

        // Még nem rögzített fix tétel: ismert összegnél azonnal fizetettnek jelöljük, különben megnyílik a szerkesztő.
        if (r.Template is { } t)
        {
            if (t.DefaultAmount is > 0)
            {
                Data.Bills.Add(new Bill
                {
                    TemplateId = t.Id,
                    Group = t.Group,
                    Name = t.Name,
                    Amount = t.DefaultAmount.Value,
                    DueDate = r.DueDate,
                    Month = monthKey,
                    Paid = true,
                    PaidAt = DateTime.Now,
                });
                await Data.SaveBillsAsync();
            }
            else
            {
                OpenRow(r, monthKey);
                fPaid = true;
                fError = "Add meg az összeget, majd mentsd.";
            }
        }
    }

    // ---------- Fix tételek ----------

    private async Task AddTemplate()
    {
        var g = (tNewGroupMode ? tNewGroup : tGroup).Trim();
        var n = tName.Trim();
        if (g.Length == 0 || n.Length == 0)
        {
            tError = "Add meg a csoportot és a megnevezést.";
            return;
        }

        int? dueDay = null;
        if (!string.IsNullOrWhiteSpace(tDueDay))
        {
            if (!int.TryParse(tDueDay.Trim(), out var dd) || dd is < 1 or > 31)
            {
                tError = "A határidő napja 1 és 31 közötti szám legyen.";
                return;
            }
            dueDay = dd;
        }

        var amount = ParseAmount(tAmount);
        Data.BillTemplates.Add(new BillTemplate { Group = g, Name = n, DefaultAmount = amount is > 0 ? amount : null, DueDay = dueDay });
        await Data.SaveBillTemplatesAsync();

        tName = "";
        tAmount = "";
        tDueDay = "";
        tNewGroup = "";
        tNewGroupMode = false;
        tGroup = g;
        tError = null;
    }

    private async Task DeleteTemplate(BillTemplate t)
    {
        Data.BillTemplates.Remove(t);
        confirmDeleteId = null;
        if (teId == t.Id) teId = null;
        await Data.SaveBillTemplatesAsync();
    }

    // ---------- Kiemelt csoport szerkesztése ----------

    private void ToggleManage(string groupName)
    {
        if (Same(managing, groupName))
        {
            managing = null;
            return;
        }
        managing = groupName;
        mgGroupName = groupName;
        teId = null;
        teError = null;
        confirmDeleteId = null;
        ngName = ngAmount = ngDueDay = "";
        ngError = null;
    }

    /// <summary>Határidő napja: üres = nincs; különben 1–31.</summary>
    private static bool TryParseDueDay(string text, out int? day)
    {
        day = null;
        if (string.IsNullOrWhiteSpace(text)) return true;
        if (!int.TryParse(text.Trim(), out var d) || d is < 1 or > 31) return false;
        day = d;
        return true;
    }

    private void StartTemplateEdit(BillTemplate t)
    {
        teId = t.Id;
        teName = t.Name;
        teAmount = t.DefaultAmount?.ToString() ?? "";
        teDueDay = t.DueDay?.ToString() ?? "";
        teError = null;
        confirmDeleteId = null;
    }

    private void CancelTemplateEdit()
    {
        teId = null;
        teError = null;
    }

    private async Task SaveTemplateEdit(BillTemplate t)
    {
        var n = teName.Trim();
        if (n.Length == 0)
        {
            teError = "Add meg a megnevezést.";
            return;
        }
        if (!TryParseDueDay(teDueDay, out var due))
        {
            teError = "A határidő napja 1 és 31 közötti szám legyen.";
            return;
        }
        var amount = ParseAmount(teAmount);
        t.Name = n;
        t.DefaultAmount = amount is > 0 ? amount : null;
        t.DueDay = due;
        teId = null;
        teError = null;
        await Data.SaveBillTemplatesAsync();
    }

    private async Task AddGroupTemplate(string groupName)
    {
        var n = ngName.Trim();
        if (n.Length == 0)
        {
            ngError = "Add meg az új tétel nevét.";
            return;
        }
        if (!TryParseDueDay(ngDueDay, out var due))
        {
            ngError = "A határidő napja 1 és 31 közötti szám legyen.";
            return;
        }
        var amount = ParseAmount(ngAmount);
        Data.BillTemplates.Add(new BillTemplate { Group = groupName, Name = n, DefaultAmount = amount is > 0 ? amount : null, DueDay = due });
        ngName = ngAmount = ngDueDay = "";
        ngError = null;
        await Data.SaveBillTemplatesAsync();
    }

    private async Task RenameGroup(string oldName)
    {
        var newName = mgGroupName.Trim();
        if (newName.Length == 0 || newName == oldName) return;
        await Data.RenameBillGroupAsync(oldName, newName);
        if (Same(group, oldName)) group = newName;
        managing = newName;
        mgGroupName = newName;
    }
}
