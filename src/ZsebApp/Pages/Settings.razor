@page "/beallitasok"
@using System.Text.Json
@inherits DataPage
@inject IJSRuntime JS
@inject SyncService Sync

<PageTitle>Beállítások – ZsebApp</PageTitle>

<header class="topbar">
    <h1>Beállítások</h1>
</header>

<div class="page">
    <SyncPanel />

    <p class="section-label">Riport</p>
    <section class="card actions">
        <a class="action" href="beallitasok/riport">
            <Icon Name="chart" Size="20" />
            <span>Kiadások és mérőórák riportja</span>
            <Icon Name="chevron-right" Size="18" Class="muted push-right" />
        </a>
    </section>

    <p class="section-label">Adatok</p>
    <section class="card">
        <div class="stat-row">
            <span>Teendők</span><span class="muted">@Data.Todos.Count</span>
        </div>
        <div class="stat-row">
            <span>Jegyzetek</span><span class="muted">@Data.Notes.Count</span>
        </div>
        <div class="stat-row">
            <span>Kiadások</span><span class="muted">@Data.Expenses.Count</span>
        </div>
        <div class="stat-row">
            <span>Számlák</span><span class="muted">@Data.Bills.Count</span>
        </div>
        <div class="stat-row">
            <span>Mérőóra-leolvasások</span><span class="muted">@Data.Meters.Count</span>
        </div>
    </section>
    <p class="hint">
        @(Sync.State.Connected
            ? "Az adatok a közös tárban vannak (és ezen a telefonon is, így net nélkül is elérhetők)."
            : "Az adatok csak ezen a telefonon, az app saját tárhelyén vannak. Időnként készíts mentést.")
    </p>

    <p class="section-label">Mentés és visszaállítás</p>
    <section class="card actions">
        <button class="action" @onclick="Export">
            <Icon Name="download" Size="20" />
            <span>Mentés fájlba (JSON)</span>
        </button>
        <label class="action">
            <Icon Name="upload" Size="20" />
            <span>Visszaállítás fájlból</span>
            <InputFile accept=".json,application/json" OnChange="ImportSelected" class="visually-hidden" />
        </label>
    </section>

    @if (pendingImport is not null)
    {
        <section class="card confirm">
            <p>
                A fájlban <strong>@pendingImport.Todos.Count</strong> teendő,
                <strong>@pendingImport.Notes.Count</strong> jegyzet,
                <strong>@pendingImport.Expenses.Count</strong> kiadás,
                <strong>@pendingImport.Bills.Count</strong> számla és
                <strong>@pendingImport.Meters.Count</strong> mérőóra-leolvasás van@(pendingImport.BillTemplates is { } bt ? $", valamint {bt.Count} fix számlatétel" : "").
                A visszaállítás <strong>felülírja</strong> a jelenlegi adatokat.
            </p>
            <div class="btn-row">
                <button class="btn" @onclick="() => pendingImport = null">Mégse</button>
                <button class="btn primary" @onclick="ConfirmImport">Visszaállítás</button>
            </div>
        </section>
    }

    @if (message is not null)
    {
        <p class="hint">@message</p>
    }

    <p class="section-label">Törlési jelszó</p>
    <section class="card form">
        @if (Data.HasDeletePassword)
        {
            <p class="form-note">A „Minden adat törlése” jelszóval védett. Módosításhoz add meg a jelenlegi jelszót.</p>
            <input class="input" type="password" placeholder="Jelenlegi jelszó" autocomplete="current-password" @bind="pwOld" @bind:event="oninput" />
        }
        else
        {
            <p class="form-note">Állíts be jelszót – enélkül a „Minden adat törlése” nem használható.</p>
        }
        <input class="input" type="password" placeholder="Új jelszó (min. 4 karakter)" autocomplete="new-password" @bind="pwNew" @bind:event="oninput" />
        <input class="input" type="password" placeholder="Új jelszó még egyszer" autocomplete="new-password" @bind="pwNew2" @bind:event="oninput" />
        @if (pwMessage is not null)
        {
            <p class="@(pwOk ? "form-note ok" : "error")">@pwMessage</p>
        }
        <button class="btn primary block" @onclick="SavePassword">@(Data.HasDeletePassword ? "Jelszó módosítása" : "Jelszó beállítása")</button>
    </section>

    <p class="section-label">Veszélyzóna</p>
    <section class="card actions">
        @switch (clearStep)
        {
            case ClearStep.None:
                <button class="action danger" @onclick="StartClear">
                    <Icon Name="trash" Size="20" />
                    <span>Minden adat törlése</span>
                </button>
                break;

            case ClearStep.Password:
                <div class="confirm">
                    <p>Add meg a törlési jelszót:</p>
                    <input class="input" type="password" placeholder="Jelszó" autocomplete="current-password" @bind="clearPassword" @bind:event="oninput" />
                    @if (clearError is not null)
                    {
                        <p class="error">@clearError</p>
                    }
                    <div class="btn-row">
                        <button class="btn" @onclick="CancelClear">Mégse</button>
                        <button class="btn primary" @onclick="CheckClearPassword">Tovább</button>
                    </div>
                </div>
                break;

            case ClearStep.Confirm:
                <div class="confirm">
                    <p><strong>Biztosan törölni szeretnéd az összes adatot?</strong> A teendők, jegyzetek, kiadások, számlák és mérőállások véglegesen törlődnek@(Sync.State.Connected ? " – a közös tárból is, tehát a párod telefonján is" : ""). Ez nem vonható vissza.</p>
                    <div class="btn-row">
                        <button class="btn" @onclick="CancelClear">Mégse</button>
                        <button class="btn danger" @onclick="ClearAll">Igen, törlés</button>
                    </div>
                </div>
                break;
        }
    </section>
    @if (clearError is not null && clearStep == ClearStep.None)
    {
        <p class="hint">@clearError</p>
    }

    <p class="section-label">Hangfelismerés napló</p>
    <section class="card actions">
        <button class="action" @onclick="ShowSpeechLog">
            <Icon Name="mic" Size="20" />
            <span>@(speechLog is null ? "Napló megjelenítése" : "Napló frissítése")</span>
        </button>
    </section>
    @if (speechLog is not null)
    {
        <pre class="card speech-log">@speechLog</pre>
        <p class="hint">Ha a mikrofon nem működik: próbáld ki a Teendők oldalon, majd gyere vissza ide, és küldj képet erről a naplóról.</p>
    }

    <p class="section-label">Telepítés iPhone-ra</p>
    <section class="card text-card">
        <ol>
            <li>Nyisd meg az app címét a <strong>Safariban</strong>.</li>
            <li>Koppints a <strong>Megosztás</strong> gombra.</li>
            <li>Válaszd a <strong>Főképernyőhöz adás</strong> lehetőséget.</li>
        </ol>
        <p class="muted">Ezután saját ikonnal, teljes képernyőn, internet nélkül is fut.</p>
    </section>

    <p class="footer muted">ZsebApp · .NET Blazor WebAssembly</p>
</div>

@code {
    private Backup? pendingImport;
    private string? speechLog;

    private async Task ShowSpeechLog() =>
        speechLog = await JS.InvokeAsync<string>("zseb.speech.getLog");
    private string? message;

    protected override Task OnInitializedAsync() => Data.EnsureLoadedAsync();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Sync.StateChanged += OnSyncState;
    }

    private void OnSyncState() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        Sync.StateChanged -= OnSyncState;
        base.Dispose();
    }

    private async Task Export()
    {
        var json = JsonSerializer.Serialize(Data.CreateBackup(), AppJsonContext.Default.Backup);
        var result = await JS.InvokeAsync<string>("zseb.saveFile", $"zsebapp-mentes_{Fmt.FileStamp(DateTime.Now)}.json", json);
        message = result switch
        {
            "shared" => "Mentés kész.",
            "downloaded" => "A mentés letöltve.",
            _ => null,
        };
    }

    private async Task ImportSelected(InputFileChangeEventArgs e)
    {
        message = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var backup = await JsonSerializer.DeserializeAsync(stream, AppJsonContext.Default.Backup);
            if (backup is null)
            {
                message = "A fájl üres.";
                return;
            }
            backup.Todos ??= [];
            backup.Notes ??= [];
            backup.Expenses ??= [];
            backup.Bills ??= [];
            backup.Meters ??= [];
            pendingImport = backup;
        }
        catch (Exception)
        {
            message = "Ez nem érvényes ZsebApp-mentés.";
        }
    }

    private async Task ConfirmImport()
    {
        if (pendingImport is null) return;
        await Data.RestoreAsync(pendingImport);
        pendingImport = null;
        message = "Visszaállítás kész.";
    }

    // ---------- Törlési jelszó ----------

    private enum ClearStep { None, Password, Confirm }

    private ClearStep clearStep = ClearStep.None;
    private string clearPassword = "";
    private string? clearError;

    private string pwOld = "";
    private string pwNew = "";
    private string pwNew2 = "";
    private string? pwMessage;
    private bool pwOk;

    private async Task SavePassword()
    {
        pwOk = false;
        if (Data.HasDeletePassword && !Data.CheckDeletePassword(pwOld))
        {
            pwMessage = "A jelenlegi jelszó nem megfelelő.";
            return;
        }
        if (pwNew.Length < 4)
        {
            pwMessage = "Az új jelszó legalább 4 karakter legyen.";
            return;
        }
        if (pwNew != pwNew2)
        {
            pwMessage = "A két új jelszó nem egyezik.";
            return;
        }

        await Data.SetDeletePasswordAsync(pwNew);
        pwOld = pwNew = pwNew2 = "";
        pwOk = true;
        pwMessage = "Jelszó elmentve.";
    }

    private void StartClear()
    {
        clearError = null;
        clearPassword = "";
        if (!Data.HasDeletePassword)
        {
            clearError = "Előbb állíts be törlési jelszót (fent, a Törlési jelszó résznél).";
            return;
        }
        clearStep = ClearStep.Password;
    }

    private void CheckClearPassword()
    {
        if (!Data.CheckDeletePassword(clearPassword))
        {
            clearError = "Hibás jelszó.";
            return;
        }
        clearError = null;
        clearPassword = "";
        clearStep = ClearStep.Confirm;
    }

    private void CancelClear()
    {
        clearStep = ClearStep.None;
        clearPassword = "";
        clearError = null;
    }

    private async Task ClearAll()
    {
        if (clearStep != ClearStep.Confirm) return;
        await Data.ClearAllAsync();
        clearStep = ClearStep.None;
        message = "Minden adat törölve.";
    }
}
