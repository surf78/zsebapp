@page "/"
@page "/index.html"
@implements IAsyncDisposable
@inject AppData Data
@inject IJSRuntime JS

<PageTitle>Teendők – ZsebApp</PageTitle>

<header class="topbar">
    <h1>Teendők</h1>
    @if (DoneCount > 0)
    {
        <button class="link-btn" @onclick="ClearDone">Készek törlése (@DoneCount)</button>
    }
</header>

<div class="page">
    <form class="add-row" @onsubmit="Add">
        <input class="input" placeholder="@(listening ? "Hallgatlak…" : $"Új teendő – {CurrentName}…")" maxlength="200" enterkeyhint="done"
               @bind="newTitle" @bind:event="oninput" @bind:after="OnTitleInput" aria-label="Új teendő" />
        @* A kattintást a zseb.js kezeli (a mikrofont csak közvetlen érintés indíthatja). *@
        <button type="button" class="icon-btn mic @(listening ? "listening" : null)" @ref="micButton"
                aria-label="@(listening ? "Felvétel leállítása" : "Feladat rögzítése hanggal")"
                aria-pressed="@(listening ? "true" : "false")">
            <Icon Name="@(listening ? "stop" : "mic")" Size="20" />
        </button>
        <button type="submit" class="icon-btn primary" disabled="@string.IsNullOrWhiteSpace(newTitle)" aria-label="Hozzáadás">
            <Icon Name="plus" />
        </button>
    </form>

    @* Csoportok: a kiválasztott csoportba kerül minden új teendő (gépelve és hanggal is). *@
    <div class="chips chips-scroll todo-groups" role="tablist" aria-label="Teendő-csoportok">
        <button type="button" role="tab" aria-selected="@(Current is null ? "true" : "false")"
                class="chip neutral @(Current is null ? "selected" : null)" @onclick="() => SelectGroup(null)">
            @AppData.DefaultTodoGroup <span class="chip-count">@Data.Todos.Count(t => !t.Done && InDefault(t))</span>
        </button>
        @foreach (var g in Data.TodoGroups)
        {
            <button type="button" role="tab" aria-selected="@(Same(g, Current) ? "true" : "false")"
                    class="chip neutral @(Same(g, Current) ? "selected" : null)" @onclick="() => SelectGroup(g)">
                @g <span class="chip-count">@Data.Todos.Count(t => !t.Done && Same(t.Group, g))</span>
            </button>
        }
        <button type="button" class="chip neutral add-chip" @onclick="StartNewGroup">+ Csoport</button>
    </div>

    @if (groupMode == GroupMode.New)
    {
        <form class="card form group-form" @onsubmit="CreateGroup">
            <input class="input" placeholder="Csoport neve, pl. Bevásárlás" maxlength="40" @bind="groupName" @bind:event="oninput" aria-label="Új csoport neve" />
            @if (groupError is not null)
            {
                <p class="error">@groupError</p>
            }
            <div class="btn-row">
                <button type="button" class="btn" @onclick="CloseGroupForm">Mégse</button>
                <button type="submit" class="btn primary">Létrehozás</button>
            </div>
        </form>
    }
    else if (groupMode == GroupMode.Edit && Current is not null)
    {
        <section class="card form group-form">
            <p class="form-title">Csoport: @Current</p>
            <input class="input" maxlength="40" @bind="groupName" @bind:event="oninput" aria-label="Csoport neve" />
            @if (groupError is not null)
            {
                <p class="error">@groupError</p>
            }
            <div class="btn-row">
                <button type="button" class="btn" @onclick="CloseGroupForm">Mégse</button>
                <button type="button" class="btn primary" @onclick="RenameGroup">Átnevezés</button>
            </div>
            @if (confirmGroupDelete)
            {
                <p class="form-note">A csoport törlődik, a teendői átkerülnek az Általános csoportba.</p>
                <button type="button" class="btn danger block" @onclick="DeleteGroup">Igen, törlöm a csoportot</button>
            }
            else
            {
                <button type="button" class="link-btn danger" @onclick="() => confirmGroupDelete = true">Csoport törlése</button>
            }
        </section>
    }
    else
    {
        <div class="todo-group-bar">
            <span>Az új teendők ide kerülnek: <strong>@CurrentName</strong></span>
            @if (Current is not null)
            {
                <button type="button" class="link-btn" @onclick="StartEditGroup">Szerkesztés</button>
            }
        </div>
    }

    @if (listening)
    {
        <p class="speech-hint listening" role="status">
            Mondd a feladatot (→ @CurrentName), a végén mondd: „vége” – vagy csak várj 5 mp-et, és elmentem.
            @if (speechStatus is not null)
            {
                <span class="speech-status">@speechStatus</span>
            }
        </p>
    }
    else if (speechHint is not null)
    {
        <p class="speech-hint" role="status">@speechHint</p>
    }

    @if (!loaded)
    {
    }
    else if (!Visible.Any())
    {
        <EmptyState IconName="list" Title="@($"Nincs teendő: {CurrentName}")"
                    Text="Írd be fent az első feladatot, vagy koppints duplán a képernyőre, és mondd ki." />
    }
    else
    {
        <p class="section-label">@OpenCount nyitott, @DoneCount kész</p>
        <ul class="card list">
            @foreach (var t in Ordered)
            {
                <li class="row @(t.Done ? "done" : null)" @key="t.Id">
                    <button class="check" @onclick="() => Toggle(t)" aria-pressed="@(t.Done ? "true" : "false")"
                            aria-label="@(t.Done ? "Visszaállítás nyitottra" : "Késznek jelöl")">
                        <Icon Name="check" Size="16" />
                    </button>
                    <div class="row-main">
                        <div>@t.Title</div>
                        <div class="row-sub">
                            <span>@Fmt.FullDate(t.CreatedAt)</span>
                            @if (!string.IsNullOrEmpty(t.CreatedBy))
                            {
                                <span class="by">@t.CreatedBy</span>
                            }
                        </div>
                    </div>
                    <button class="icon-btn ghost" @onclick="() => Delete(t)" aria-label="Törlés">
                        <Icon Name="trash" Size="20" />
                    </button>
                </li>
            }
        </ul>
        <p class="hint">Tipp: dupla koppintás a képernyőn = hangos rögzítés, a végén mondd: „vége”, vagy várj 5 mp-et.</p>
    }
</div>

@code {
    private bool loaded;
    private string newTitle = "";

    // Hangfelismerés
    private ElementReference micButton;
    private DotNetObjectReference<Todos>? selfRef;
    private bool listening;
    private string? speechHint;
    private string? speechStatus;
    private CancellationTokenSource? stopWordCts;

    // ---------- Csoportok ----------

    private enum GroupMode { None, New, Edit }

    private GroupMode groupMode;
    private string groupName = "";
    private string? groupError;
    private bool confirmGroupDelete;

    /// <summary>A megnyitott csoport (null = Általános), ha még létezik.</summary>
    private string? Current => Data.ValidCurrentTodoGroup;

    private string CurrentName => Data.CurrentTodoGroupName;

    /// <summary>Az Általánoshoz tartozik: csoport nélküli vagy „Általános”.</summary>
    private bool InDefault(TodoItem t) => AppData.IsDefaultTodoGroup(t.Group);

    private static bool Same(string? a, string? b) =>
        a is not null && b is not null && string.Equals(a.Trim(), b.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>A megnyitott csoport teendői.</summary>
    private IEnumerable<TodoItem> Visible => Current is null ? Data.Todos.Where(InDefault) : Data.Todos.Where(t => Same(t.Group, Current));

    private async Task SelectGroup(string? g)
    {
        CloseGroupForm();
        await Data.SetCurrentTodoGroupAsync(g);
    }

    private void StartNewGroup()
    {
        groupMode = GroupMode.New;
        groupName = "";
        groupError = null;
    }

    private void StartEditGroup()
    {
        groupMode = GroupMode.Edit;
        groupName = Current ?? "";
        groupError = null;
        confirmGroupDelete = false;
    }

    private void CloseGroupForm()
    {
        groupMode = GroupMode.None;
        groupError = null;
        confirmGroupDelete = false;
    }

    private async Task CreateGroup()
    {
        var name = groupName.Trim();
        if (name.Length == 0)
        {
            groupError = "Add meg a csoport nevét.";
            return;
        }
        if (!await Data.AddTodoGroupAsync(name))
        {
            groupError = "Ilyen nevű csoport már van.";
            return;
        }
        CloseGroupForm();
        await Data.SetCurrentTodoGroupAsync(name);   // az új csoport lesz kiválasztva
    }

    private async Task RenameGroup()
    {
        if (Current is not { } old) return;
        var name = groupName.Trim();
        if (name.Length == 0)
        {
            groupError = "Add meg a csoport nevét.";
            return;
        }
        if (AppData.IsDefaultTodoGroup(name) || !Same(name, old) && Data.TodoGroups.Any(g => Same(g, name)))
        {
            groupError = "Ilyen nevű csoport már van.";
            return;
        }
        await Data.RenameTodoGroupAsync(old, name);
        CloseGroupForm();
    }

    private async Task DeleteGroup()
    {
        if (Current is not { } g) return;
        await Data.DeleteTodoGroupAsync(g);
        CloseGroupForm();
    }

    private int DoneCount => Visible.Count(t => t.Done);
    private int OpenCount => Visible.Count() - DoneCount;

    private IEnumerable<TodoItem> Ordered =>
        Visible.Where(t => !t.Done).OrderByDescending(t => t.CreatedAt)
            .Concat(Visible.Where(t => t.Done).OrderByDescending(t => t.CompletedAt));

    protected override async Task OnInitializedAsync()
    {
        await Data.EnsureLoadedAsync();
        Data.TodosChanged += OnTodosChanged;
        Data.Changed += OnTodosChanged;          // pl. a másik telefonon létrehozott csoport
        loaded = true;
    }

    // A lebegő mikrofon gombbal felvett teendő azonnal megjelenik a listában.
    private void OnTodosChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("zseb.speech.attach", micButton, selfRef, SpeechText.Language, SpeechText.StopWord);
        // Dupla koppintás bárhol a képernyőn ugyanazt csinálja, mint a mikrofon gomb.
        await JS.InvokeVoidAsync("zseb.speech.attachDoubleTap", selfRef, SpeechText.Language, SpeechText.StopWord);
    }

    [JSInvokable]
    public void OnSpeechStart()
    {
        listening = true;
        speechHint = null;
        speechStatus = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechStatus(string kind)
    {
        speechStatus = SpeechText.StatusMessage(kind);
        StateHasChanged();
    }

    // Billentyűzetes diktálás (vagy gépelés) után: ha a szöveg „vége” szóra végződik és
    // 1,5 mp-ig nem változik, a teendő automatikusan mentésre kerül.
    private void OnTitleInput()
    {
        stopWordCts?.Cancel();
        if (listening || !SpeechText.TryStripStopWord(newTitle, out _)) return;
        var cts = stopWordCts = new CancellationTokenSource();
        _ = SaveAfterPauseAsync(cts.Token);
    }

    private async Task SaveAfterPauseAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(1500, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (!SpeechText.TryStripStopWord(newTitle, out var rest)) return;
        var title = SpeechText.Clean(rest);
        if (title.Length == 0) return;
        newTitle = "";
        speechHint = $"Mentve: {title}";
        await Data.AddTodoAsync(title);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechResult(string text)
    {
        // Élő átirat: beszéd közben is látszik, mit ért a felismerő.
        newTitle = SpeechText.Clean(text);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSpeechEnd(string text, bool committed)
    {
        listening = false;
        speechStatus = null;
        var cleaned = SpeechText.Clean(text);
        if (committed && cleaned.Length > 0)
        {
            // „vége” szóra automatikus mentés
            await Data.AddTodoAsync(cleaned);
            newTitle = "";
            speechHint = $"Mentve: {cleaned}";
        }
        else if (cleaned.Length > 0)
        {
            newTitle = cleaned;
            speechHint = "Ellenőrizd a szöveget, majd koppints a + gombra.";
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnSpeechError(string code)
    {
        listening = false;
        speechStatus = null;
        speechHint = SpeechText.ErrorMessage(code);
        StateHasChanged();
    }

    private async Task Add()
    {
        var title = newTitle.Trim();
        if (title.Length == 0) return;

        newTitle = "";
        speechHint = null;
        await Data.AddTodoAsync(title);
    }

    public async ValueTask DisposeAsync()
    {
        Data.TodosChanged -= OnTodosChanged;
        Data.Changed -= OnTodosChanged;
        stopWordCts?.Cancel();
        try
        {
            await JS.InvokeVoidAsync("zseb.speech.detachDoubleTap");
            await JS.InvokeVoidAsync("zseb.speech.detach", micButton);
        }
        catch (JSDisconnectedException)
        {
        }
        selfRef?.Dispose();
    }

    private async Task Toggle(TodoItem t)
    {
        t.Done = !t.Done;
        t.CompletedAt = t.Done ? DateTime.Now : null;
        await Data.SaveTodosAsync();
    }

    private async Task Delete(TodoItem t)
    {
        Data.Todos.Remove(t);
        await Data.SaveTodosAsync();
    }

    private async Task ClearDone()
    {
        // Csak a látható (kiválasztott csoportbeli) készeket törli.
        var current = Current;
        Data.Todos.RemoveAll(t => t.Done && (current is null ? InDefault(t) : Same(t.Group, current)));
        await Data.SaveTodosAsync();
    }
}
