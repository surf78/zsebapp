@* Egyszerű vonalas ikonok inline SVG-ként – nincs külső függőség. *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true"
     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3" />
            break;
        case "chevron-left":
            <path d="M15 5l-7 7 7 7" />
            break;
        case "chevron-right":
            <path d="M9 5l7 7-7 7" />
            break;
        case "list":
            <path d="M9 6h11M9 12h11M9 18h11" />
            <circle cx="4.5" cy="6" r="1" fill="currentColor" />
            <circle cx="4.5" cy="12" r="1" fill="currentColor" />
            <circle cx="4.5" cy="18" r="1" fill="currentColor" />
            break;
        case "note":
            <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
            <path d="M14 3v6h6M8 13h8M8 17h5" />
            break;
        case "wallet":
            <path d="M3 7a2 2 0 0 1 2-2h13v4" />
            <path d="M3 7v11a2 2 0 0 0 2 2h15V9H5a2 2 0 0 1-2-2z" />
            <circle cx="16" cy="14.5" r="1.2" fill="currentColor" />
            break;
        case "gear":
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            break;
        case "home":
            <path d="M3 11l9-7 9 7" />
            <path d="M5 10v10h14V10" />
            <path d="M10 20v-6h4v6" />
            break;
        case "building":
            <rect x="5" y="3" width="14" height="18" rx="1.5" />
            <path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2M11 21v-3h2v3" />
            break;
        case "repeat":
            <path d="M17 2l4 4-4 4" />
            <path d="M3 11V9a3 3 0 0 1 3-3h15" />
            <path d="M7 22l-4-4 4-4" />
            <path d="M21 13v2a3 3 0 0 1-3 3H3" />
            break;
        case "receipt":
            <path d="M6 3h12v18l-3-2-3 2-3-2-3 2z" />
            <path d="M9 8h6M9 12h6M9 16h3" />
            break;
        case "filter":
            <path d="M4 5h16l-6 7.5V19l-4-2v-4.5z" />
            break;
        case "chevron-down":
            <path d="M6 9l6 6 6-6" />
            break;
        case "chart":
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
            break;
        case "gauge":
            <path d="M4 17a8 8 0 1 1 16 0" />
            <path d="M12 17l4-5" />
            <circle cx="12" cy="17" r="1.4" fill="currentColor" />
            break;
        case "flame":
            <path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2.2 1-3.6 2.2-4.8.3 1.6 1 2.6 2 3 0-3 .3-5.6.8-8.2z" />
            break;
        case "bolt":
            <path d="M13 3L5 13.5h6L10 21l8-10.5h-6z" />
            break;
        case "drop":
            <path d="M12 3.5c3 4 6 7.2 6 10.5a6 6 0 0 1-12 0c0-3.3 3-6.5 6-10.5z" />
            break;
        case "mic":
            <rect x="9" y="3" width="6" height="11" rx="3" />
            <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7" />
            break;
        case "stop":
            <rect x="7" y="7" width="10" height="10" rx="2" fill="currentColor" />
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            break;
        case "upload":
            <path d="M12 20V9M7 14l5-5 5 5M5 4h14" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public string? Class { get; set; }
}
